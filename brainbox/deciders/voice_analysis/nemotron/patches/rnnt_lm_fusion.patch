diff --git a/src/asr/decoders/ngram_fusion.cpp b/src/asr/decoders/ngram_fusion.cpp
new file mode 100644
index 0000000..c3659e4
--- /dev/null
+++ b/src/asr/decoders/ngram_fusion.cpp
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "ngram_fusion.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <unordered_map>
+
+namespace nemo_speech::asr {
+
+namespace {
+constexpr float kLog10ToLn = 2.302585093f;
+
+float
+parse_score(const std::string& text) {
+    return std::strtof(text.c_str(), nullptr) * kLog10ToLn;
+}
+}  // namespace
+
+NgramFusionLm::NgramFusionLm(const std::string& arpa_path, int vocab_size) {
+    std::ifstream in(arpa_path);
+    if (!in)
+        throw std::runtime_error("NgramFusionLm: cannot read " + arpa_path);
+    const auto fail = [&arpa_path](const std::string& what) {
+        throw std::runtime_error("NgramFusionLm: " + arpa_path + ": " + what);
+    };
+
+    // Contexts by their text in the ARPA, needed only here.
+    std::unordered_map<std::string, int> contexts;
+    const auto context = [&](const std::string& ngram) {
+        const auto it = contexts.find(ngram);
+        if (it == contexts.end())
+            fail("n-gram '" + ngram + "' is missing");
+        return it->second;
+    };
+    const auto token_id = [&](const std::string& word) {
+        char* end = nullptr;
+        const long id = std::strtol(word.c_str(), &end, 10);
+        if (word.empty() || *end != '\0' || id < 0 || id >= vocab_size)
+            fail("'" + word + "' is not a token id");
+        return static_cast<int>(id);
+    };
+
+    states_[kRoot].arcs.assign(vocab_size, Arc{-1, kRoot, 0.0f});  // -1: not among the unigrams
+    bool has_unk = false;
+    bool ended = false;
+    float unk = 0.0f;
+    int max_order = 0;
+    int order = 0;
+    std::vector<long> declared, found;  // n-grams per order: in the header, in the file
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.rfind("ngram ", 0) == 0) {
+            const int n = std::atoi(line.c_str() + 6);
+            const size_t eq = line.find('=');
+            if (n < 1 || eq == std::string::npos)
+                fail("bad line '" + line + "'");
+            max_order = std::max(max_order, n);
+            declared.resize(max_order + 1, 0);
+            found.resize(max_order + 1, 0);
+            declared[n] = std::atol(line.c_str() + eq + 1);
+            continue;
+        }
+        if (line == "\\end\\") {
+            ended = true;
+            break;
+        }
+        if (line.empty() || line == "\\data\\")
+            continue;
+        if (line[0] == '\\') {  // \N-grams:
+            order = std::atoi(line.c_str() + 1);
+            if (order < 1 || order > max_order)
+                fail("bad line '" + line + "'");
+            continue;
+        }
+
+        const size_t tab = line.find('\t');
+        if (order == 0 || tab == std::string::npos)
+            fail("bad line '" + line + "'");
+        const size_t second_tab = line.find('\t', tab + 1);
+        const std::string ngram = line.substr(tab + 1, second_tab - tab - 1);
+        if (std::count(ngram.begin(), ngram.end(), ' ') != order - 1)
+            fail("bad line '" + line + "'");
+        ++found[order];
+        const float score = parse_score(line);
+        const float backoff =
+            second_tab == std::string::npos ? 0.0f : parse_score(line.substr(second_tab + 1));
+        const size_t last_space = ngram.rfind(' ');
+        const std::string word =
+            last_space == std::string::npos ? ngram : ngram.substr(last_space + 1);
+        if (word == "</s>")
+            continue;
+        if (ngram == "<unk>") {
+            unk = score;
+            has_unk = true;
+            continue;
+        }
+
+        const int suffix = order == 1 ? kRoot : context(ngram.substr(ngram.find(' ') + 1));
+        int to = suffix;
+        if (order < max_order || word == "<s>") {
+            to = static_cast<int>(states_.size());
+            contexts[ngram] = to;
+            states_.emplace_back();
+            states_[to].backoff_to = suffix;
+            states_[to].backoff = backoff;
+        }
+        if (word == "<s>") {
+            start_state_ = to;
+            continue;
+        }
+        const int token = token_id(word);
+        if (order == 1)
+            states_[kRoot].arcs[token] = Arc{token, to, score};
+        else
+            states_[context(ngram.substr(0, last_space))].arcs.push_back(Arc{token, to, score});
+    }
+    if (!ended || found != declared)
+        fail("it is cut short: the n-grams do not match the header");
+    if (!has_unk || start_state_ == kRoot)
+        fail("<unk> or <s> is missing");
+
+    // As normalize_unk in NeMo: the tokens out of the unigrams share <unk>.
+    const auto unknown = std::count_if(
+        states_[kRoot].arcs.begin(), states_[kRoot].arcs.end(),
+        [](const Arc& arc) { return arc.token < 0; });
+    const float unknown_score = unk - std::log(static_cast<float>(std::max<long>(unknown, 1)));
+    for (int token = 0; token < vocab_size; ++token) {
+        Arc& arc = states_[kRoot].arcs[token];
+        if (arc.token < 0)
+            arc = Arc{token, kRoot, unknown_score};
+    }
+    for (State& state : states_) {
+        std::sort(state.arcs.begin(), state.arcs.end(), [](const Arc& a, const Arc& b) {
+            return a.token < b.token;
+        });
+    }
+}
+
+void
+NgramFusionLm::scores(int state, float* out) const {
+    const State& s = states_[state];
+    if (state != kRoot) {
+        scores(s.backoff_to, out);
+        const size_t vocab_size = states_[kRoot].arcs.size();
+        for (size_t token = 0; token < vocab_size; ++token) out[token] += s.backoff;
+    }
+    for (const Arc& arc : s.arcs) out[arc.token] = arc.score;
+}
+
+int
+NgramFusionLm::advance(int state, int token) const {
+    while (true) {
+        const State& s = states_[state];
+        const auto arc = std::lower_bound(
+            s.arcs.begin(), s.arcs.end(), token,
+            [](const Arc& a, int value) { return a.token < value; });
+        if (arc != s.arcs.end() && arc->token == token)
+            return arc->to;
+        if (state == kRoot)  // a token out of the vocabulary
+            return kRoot;
+        state = s.backoff_to;
+    }
+}
+
+}  // namespace nemo_speech::asr
diff --git a/src/asr/decoders/ngram_fusion.h b/src/asr/decoders/ngram_fusion.h
new file mode 100644
index 0000000..11500f5
--- /dev/null
+++ b/src/asr/decoders/ngram_fusion.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: Apache-2.0
+// Token-level n-gram LM for RNNT shallow fusion, as NeMo's NGramGPULanguageModel for one
+// hypothesis. The words of the ARPA are token ids. A token missing in a state backs off down to the
+// root, where the tokens out of the unigrams share <unk>. Immutable: the streams of a recognizer
+// share one model.
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace nemo_speech::asr {
+
+class NgramFusionLm {
+   public:
+    // Throws if the file is not an ARPA over the token ids of [0, vocab_size).
+    NgramFusionLm(const std::string& arpa_path, int vocab_size);
+
+    // The state at the beginning of a sentence.
+    int start_state() const { return start_state_; }
+
+    // Writes log P(token | state) for the whole vocabulary to out[0, vocab_size).
+    void scores(int state, float* out) const;
+
+    // The state after `token` from `state`.
+    int advance(int state, int token) const;
+
+   private:
+    struct Arc {
+        int token;
+        int to;
+        float score;
+    };
+    struct State {
+        std::vector<Arc> arcs;  // by token; the root has exactly one per token
+        int backoff_to = 0;
+        float backoff = 0.0f;
+    };
+    static constexpr int kRoot = 0;
+
+    std::vector<State> states_{State{}};  // states_[0] = root
+    int start_state_ = kRoot;
+};
+
+}  // namespace nemo_speech::asr
